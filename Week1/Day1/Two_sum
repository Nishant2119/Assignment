class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        unordered_map<int,int>data;
        vector<int> ans;
        for (int i =0;i<nums.size();i++)
        {
            if(data.find(target - nums[i]) == data.end())
            {
                data[nums[i]]=i;
            }
            else 
            {
                vector<int> ans ={i,data[target-nums[i]]};
                return ans;
            }
        }
        
        return ans;
    }
};